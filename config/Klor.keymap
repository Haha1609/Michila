#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 300   // mousescroll SPEED

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <3000>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <1000>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off {
    hold-time-ms = <3000>; // Only turn off it the key is held for 3 seconds or longer.
};

&mt { flavor = "tap-preferred"; };

&lt {
    tapping-term-ms = <300>;
    flavor = "balanced";
};

&sk {
    quick-release;
    lazy;
};

/ {
    behaviors {
        shift_capsword_capslok: shift_capsword_capslok {
            compatible = "zmk,behavior-tap-dance";
            label = "SHIFT_CAPSWORD_CAPSLOK";
            #binding-cells = <0>;
            bindings = <&sk LEFT_SHIFT>, <&caps_word>, <&kp CAPSLOCK>;
        };

        GUI_ctrlA: GUI_ctrlA {
            compatible = "zmk,behavior-tap-dance";
            label = "GUI_CTRLA";
            #binding-cells = <0>;
            bindings = <&kp LEFT_GUI>, <&kp LC(A)>;
        };

        laughing: laughing {
            compatible = "zmk,behavior-tap-dance";
            label = "LAUGHING";
            #binding-cells = <0>;
            bindings = <&hihi>, <&haha>;
        };

        lower_ctrlC: lower_ctrlC {
            compatible = "zmk,behavior-tap-dance";
            label = "LOWER_CTRLC";
            #binding-cells = <0>;
            bindings = <&mo 1>, <&kp LC(C)>;
        };

        ctrl_ctrlV: ctrl_ctrlV {
            compatible = "zmk,behavior-tap-dance";
            label = "CTRL_CTRLV";
            #binding-cells = <0>;
            bindings = <&kp LCTRL>, <&kp LC(V)>;
        };

        mo_to_FN: mo_to_FN {
            compatible = "zmk,behavior-tap-dance";
            label = "MO_TO_FN";
            #binding-cells = <0>;
            bindings = <&mo 3>, <&to 3>;
        };

        mo_to_Mouse: mo_to_Mouse {
            compatible = "zmk,behavior-tap-dance";
            label = "MO_TO_MOUSE";
            #binding-cells = <0>;
            bindings = <&mo 4>, <&to 4>;
        };

        haizz_huhu: haizz_huhu {
            compatible = "zmk,behavior-tap-dance";
            label = "HAIZZ_HUHU";
            #binding-cells = <0>;
            bindings = <&haizzzz>, <&huhu>;
        };

        GUIL_CtrlAltDel: GUIL_CtrlAltDel {
            compatible = "zmk,behavior-tap-dance";
            label = "GUIL_CTRLALTDEL";
            #binding-cells = <0>;
            bindings = <&kp LG(L)>, <&kp LC(LA(DELETE))>;
        };
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";
            bindings = <
           &kp Q     &kp W    &kp E      &kp R      &kp T      &kp Y      &kp U     &kp I      &kp O    &kp P
&kp ESC    &kp A     &kp S    &kp D      &kp F      &kp G      &kp H      &kp J     &kp K      &kp L    &kp SEMI  &kp BSPC
&kp LSHFT  &kp Z     &kp X    &kp C      &kp V      &kp B      &kp N      &kp M     &kp COMMA  &kp DOT  &kp FSLH  &kp DEL
                     &kp RET  &kp LCTRL  &kp LALT   &kp SPACE  &kp SPACE  &kp LALT  &kp LCTRL  &kp RET
&kp LEFT   &kp LEFT  &kp RET  &kp DOWN   &kp RIGHT                        &kp LEFT  &kp DOWN   &kp RET  &kp UP    &kp RIGHT
            >;
        };

        lower_layer {
            display-name = "Lower Layer";
            bindings = <
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
            >;
        };

        raise_layer {
            display-name = "Raise Layer";
            bindings = <
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
            >;
        };

        FN {
            bindings = <
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
            >;
        };

        mouse {
            bindings = <
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_5 {
            bindings = <
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_6 {
            bindings = <
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
